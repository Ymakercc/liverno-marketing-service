# Copy this file to .env and fill values locally. Do not commit .env.

# Fumeng Open Platform
FUMENG_BASE_URL=https://opengw.fumamx.com
FUMENG_APP_ID=
FUMENG_APP_SECRET=
# Owner account used as the marketing public-sea pool.
FUMENG_PUBLIC_SEA_OWNER_ID=
FUMENG_WRITEBACK_ENABLED=false
# Fumeng dictionary 12: 27 = 邮件营销
FUMENG_EMAIL_TRACK_MODE_ID=

# Apollo REST API
APOLLO_BASE_URL=https://api.apollo.io
APOLLO_API_KEY=
APOLLO_MAX_PEOPLE_PER_COMPANY=5
APOLLO_MINIMUM_COMPANY_SCORE=75

# OpenAI-compatible relay. Most relay services support chat_completions.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_API_STYLE=chat_completions
OPENAI_REASONING_EFFORT=low
OPENAI_WEB_SEARCH_ENABLED=false
# Optional: protect relay settings changes with a token. Without it, localhost/private LAN access is allowed.
# SETTINGS_ADMIN_TOKEN=

# Xiaomi MiMo for inbound inquiry classification. This is independent from
# the OpenAI-compatible model used to research customers and draft outbound mail.
MIMO_INBOX_CLASSIFICATION_ENABLED=false
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1
MIMO_MODEL=mimo-v2.5-pro
MIMO_API_KEY=
MIMO_TIMEOUT_MS=45000

# Feishu Bitable for AI follow-up/review records
FEISHU_BASE_URL=https://open.feishu.cn
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_APP_TOKEN=
FEISHU_TABLE_ID=
FEISHU_SEND_PERMISSION_FIELD=

# Local V2 service (localhost only by default)
HOST=127.0.0.1
PORT=8787
# Leave empty for first-time setup from this computer. The application stores only
# a scrypt hash here; never put the plaintext login password in this file.
WEB_LOGIN_PASSWORD_HASH=
SALES_TEAM_NAME=MEAN WELL KULON TEAM
SALES_EMAIL=
YOUR_COMPANY_NAME=Hangzhou Kulon Electronics Co.,Ltd.
YOUR_WEBSITE=https://meanwell-led.com/
SALES_LOGO_URL=https://meanwell.business/email_images/meanwell-kulon-logo.png
SIGNATURE_BACKGROUND_URL=https://meanwell.business/email_images/signature-bgc.png
EMAIL_ASSET_PUBLIC_BASE_URL=https://meanwell.business
# Hostinger stores concrete model images in the existing nested product library.
EMAIL_PRODUCT_IMAGE_DIRECTORY=public/assets/product-images
EMAIL_PRODUCT_IMAGE_MANIFEST_PATH=public/assets/product-images/index.json
EMAIL_PRODUCT_IMAGE_PUBLIC_PATH=/MarketResource/AllSeriesPicturesOfMEANWELL
EMAIL_PRODUCT_IMAGE_ALLOW_BASE_MODEL_FALLBACK=true

# Private price catalog. Keep this file outside GitHub; only derived marketing
# prices are rendered into emails. Newer prices (on/after 2026-07-01) are cost;
# older prices receive 5% before the 5% marketing markup.
PRICE_CATALOG_PATH=.local_docs/pricing/Kulon最新报价_20260829.md
PRICE_COST_CUTOVER_DATE=2026-07-01
PRICE_LEGACY_COST_MARKUP=0.05
PRICE_MARKETING_MARKUP=0.05
PRICE_CURRENCY=CNY
PRICE_EMAIL_CURRENCY=USD
PRICE_CNY_PER_USD=7.20
PRICE_MAX_EMAIL_MODELS=8

# Email sending provider. Enable only after the controlled dry run passes.
FROM_EMAIL=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_REPLY_TO_EMAIL=
BREVO_SENDER_NAME=MEAN WELL KULON TEAM
EMAIL_SENDING_ENABLED=false
# Random secret passed by Brevo as a Bearer token when calling our webhook.
BREVO_WEBHOOK_TOKEN=
# Public callback URL, for example https://brevo-webhook.example.com/api/webhooks/brevo
BREVO_WEBHOOK_PUBLIC_URL=
# Local SQLite database; this directory is ignored by Git.
DELIVERY_DATABASE_PATH=.data/delivery.sqlite
# Dedicated Cloudflare Tunnel. The token is fetched at runtime and is never stored here.
BREVO_TUNNEL_ID=
CLOUDFLARED_BIN=.tools/cloudflared
CLOUDFLARED_ORIGIN_CERT=
BREVO_GATEWAY_PORT=8790
BREVO_GATEWAY_TARGET=http://127.0.0.1:8787/api/webhooks/brevo

# Ali Enterprise Mail inbox monitoring. Prefer entering the account and client
# authorization code in the local web console; they are then encrypted under .data/.
MAILBOX_IMAP_PASSWORD=
MAILBOX_MONITORING_ENABLED=false
MAILBOX_IMAP_HOST=imap.qiye.aliyun.com
MAILBOX_IMAP_PORT=993
MAILBOX_IMAP_SECURE=true
MAILBOX_IMAP_USERNAME=
MAILBOX_IMAP_FOLDER=INBOX
MAILBOX_INITIAL_LOOKBACK_DAYS=30
MAILBOX_MAX_MESSAGES_PER_POLL=200
MAILBOX_DATABASE_PATH=.data/inbox.sqlite
MAILBOX_SETTINGS_PATH=.data/mailbox-settings.enc
MAILBOX_SETTINGS_KEY_PATH=.data/mailbox-settings.key

# Marketing queue and n8n automation. The daily company target is the only
# normal operating control; research and sending limits remain safety caps.
MARKETING_DATABASE_PATH=.data/marketing.sqlite
RESEARCH_DATABASE_PATH=.data/research.sqlite
RESEARCH_MAX_MATCHES=3
MARKETING_AUTOMATION_ENABLED=false
# Apollo research is independent from queued email delivery. The service sets this to false
# automatically when Apollo explicitly reports exhausted credits.
APOLLO_RESEARCH_ENABLED=true
APOLLO_RESEARCH_PAUSE_REASON=
# Generate with: openssl rand -hex 32
AUTOMATION_TOKEN=
SETTINGS_ADMIN_TOKEN=
PILOT_AUDIT_LIMIT=
# Daily marketing company target/upper limit. Actual count can be lower when email quota is reached.
DAILY_COMPANY_LIMIT=300
# Internal Apollo/qualification safety ceiling, not the Apollo account credit balance.
DAILY_RESEARCH_LIMIT=1000
# Hard Brevo email safety cap.
DAILY_SEND_LIMIT=300
COMPANY_COOLDOWN_DAYS=7
SEND_WINDOW_START_HOUR=9
SEND_WINDOW_END_HOUR=16
SECOND_TOUCH_ENABLED=false
SECOND_TOUCH_PILOT_LIMIT=50
SECOND_TOUCH_MAX_CONTACTS_PER_COMPANY=2
SECOND_TOUCH_MULTI_OPEN_DELAY_DAYS=2
SECOND_TOUCH_SINGLE_OPEN_DELAY_DAYS=5
AUTO_APPROVE_SCORE=85
